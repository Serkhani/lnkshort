# Database / Docker Compose credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lnkshort

# Application Database Connection
DATABASE_URL=postgres://postgres:postgres@localhost:5454/lnkshort

# Server Configuration
HOST=0.0.0.0
PORT=3000

# Logging
RUST_LOG=lnkshort=debug,tower_http=debug

# Database Connection Pool
DB_MAX_CONNECTIONS=12
DB_MIN_CONNECTIONS=2
QUERY_TIMEOUT_MS=300

# Link Redirection & Retries
LINK_MAX_RETRIES=3
DEFAULT_CACHE_CONTROL=public, max-age=300, s-maxage=300, state-while-revalidate=300, stale-if-error=300

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_SECOND=50
RATE_LIMIT_BURST=100
